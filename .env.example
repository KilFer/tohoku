# --- Docker runtime ---
DOCKER_NETWORK=tohoku        # existing external network shared with Karakeep and Trilium
TZ=UTC                       # IANA timezone

# --- Karakeep (reachable from the container on DOCKER_NETWORK) ---
KARAKEEP_URL=http://karakeep-web:3000
KARAKEEP_API_KEY=            # Karakeep → Settings → API Keys

# --- Trilium ---
TRILIUM_URL=http://trilium:8080
TRILIUM_ETAPI_TOKEN=         # Trilium → Options → ETAPI → Create token
# DESTINOS_FILE=config/destinos.yaml   # Karakeep lists, Trilium roots and prompts (see config/destinos.example.yaml)

# --- OpenRouter ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=            # multimodal (accepts images); choose with `tohoku eval`
# OPENROUTER_TEXT_MODEL=     # optional, cheaper, for content without images and for merges
OPENROUTER_DAILY_BUDGET_USD=1.0

# --- Google Places API (New) ---
GOOGLE_PLACES_API_KEY=       # restricted to "Places API (New)"
PLACES_DAILY_LIMIT=150       # ~4,500/month < 5,000 free of Text Search Pro

# --- Whisper ---
WHISPER_MODEL=large-v3       # large-v3-turbo if you need more speed
WHISPER_COMPUTE_TYPE=int8
WHISPER_THREADS=6

# --- Media ---
REEL_KEYFRAMES_ENABLED=true  # false = audio+text only for videos (posts still use vision)
KEYFRAMES_MAX=6
POST_IMAGES_MAX=10
IMAGE_MAX_SIDE=1024
MAX_VIDEO_DURATION_MIN=15
# INSTAGRAM_COOKIES_FILE=/secrets/instagram_cookies.txt   # Netscape format, secondary account
INSTAGRAM_MIN_INTERVAL_SECONDS=20   # minimum gap between Instagram downloads

# --- ntfy notifications ---
NTFY_URL=                    # e.g. https://ntfy.example.com
NTFY_TOPIC=tohoku
NTFY_TOKEN=
NTFY_DAILY_SUMMARY=false

# --- Behaviour ---
POLL_INTERVAL_MINUTES=10
DESTINATION_MIN_CONFIDENCE=0.4
DESTINATION_REVIEW_CONFIDENCE=0.7
ITEM_REVIEW_CONFIDENCE=0.7
COSA_DUPLICATE_SIMILARITY=0.85
